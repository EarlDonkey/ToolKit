# ============================================================
# OS junk
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============================================================
# Toolkit-specific: workspace data
# ============================================================
# Workspaces contain engagement data, findings DBs, credentials,
# captured hashes, and loot. Never commit these.
workspaces/
.workspaces/

# Any stray workspace.db from running modules in the toolkit root
workspace.db
workspace.db-journal
workspace.db-wal
workspace.db-shm

# ============================================================
# Toolkit-specific: output artifacts
# ============================================================
# Dossiers and reports generated by recon.investigate
dossier.html
dossier.md
dossier.json
dossier/
reports/
report/

# Screenshots captured by net.screenshot
screenshots/

# Loot directory (shells, hashes, captured artifacts)
loot/
shells/

# Any *.log files written by modules (transcripts, shell captures)
*.log
!requirements*.txt

# ============================================================
# Toolkit-specific: session / scan data
# ============================================================
# Session transcripts from core/shell_handler.py
*.session
session_*.txt

# JSON output from modules run without --store
*.findings.json
*.report.json
*.dossier.json

# Temporary files from exploit chains
tk_*.php
tk_*.jsp
tk_*.aspx
tk_*.py
!payload/rce/*.py
tk_rce_*
tk_probe_*
tk_upload_*

# Compiled RCE payloads (cached under ~/.toolkit, not in repo,
# but just in case someone copies them back)
*.dll
*.exe
lib_mysqludf_sys.so
pg_cmd_exec.so
clr_cmd_exec.dll

# But keep the source files
!payload/rce/*.c
!payload/rce/*.cs

# ============================================================
# Toolkit-specific: wordlists downloaded locally
# ============================================================
# Keep the small embedded wordlist in wordlists/subdomains.txt.
# Ignore anything else a user drops in.
wordlists/*
!wordlists/subdomains.txt
!wordlists/README.md

# ============================================================
# Toolkit-specific: test / lab targets
# ============================================================
# Local test artifacts — do not commit
test*.py
test_*.py
!payload/rce/*.py
names.txt
tyas.txt
lab_server.py.bak

# ============================================================
# Secrets and local config
# ============================================================
# Never commit API keys, tokens, credentials, or machine-specific
# config. If a module ends up writing a config file, it goes here.
config.local.*
secrets.json
.env
.env.*
!config.example.json

# GitHub token / API key files users may create
.github-token
github_token.txt
urlscan_key.txt
hunter_key.txt
shodan_key.txt

# ============================================================
# Signatures / cache directories that get regenerated
# ============================================================
# OUI cache written by net/oui.py
~/.toolkit/
.toolkit/

# Any downloaded signature databases
recon/signatures/*.json.cache
recon/signatures/*.txt.cache

# ============================================================
# IDE-specific project files
# ============================================================
*.code-workspace
*.sublime-workspace